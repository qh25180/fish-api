# ═══ 基础配置 ═══

# 文本文件存放目录
TEXT_FILES_DIR=./novels

# 允许的文件扩展名（逗号分隔）
TEXT_FILE_EXTENSIONS=.txt,.md

# 默认编码（auto 表示自动检测）
DEFAULT_ENCODING=auto

# 通用 API 访问口令（不配置或留空则不验证）
# 除 Legado 接口外的所有 API 与页面均需验证此口令；
# 支持 Authorization: Bearer <token>（外部工具/JS）与 Cookie(qhapi_token)（浏览器页面间）。
# 浏览器访问流程：任意页面未认证 → 跳转 /login 输入口令 → 写入 Cookie → 跳转索引页。
API_TOKEN=qhapi-token

# Swagger 文档开关（默认关闭；开启后 /docs、/openapi.json 需认证访问）
DOCS_ENABLED=false

# Legado HTTP API 整体开关（默认开启，保持外部工具兼容）。
# 注意：Legado 接口为外部协议（Legado App / VS Code 插件 / 脚本），永不验证 token，
# 关闭后相关接口（getBookshelf/getChapterList/getBookContent/saveBookProgress 等）
# 返回 403「未开放」。
LEGADO_ENABLED=true


# ═══ 远程拉取下载接口（从 URL 拉取文件到服务器）═══

# 是否启用远程拉取下载
REMOTE_DOWNLOAD_ENABLED=false

# 是否允许下载内网地址的文件
REMOTE_DOWNLOAD_ALLOW_INTRANET=false


# ═══ 文件上传接口（从本地上传到服务器）═══

# 是否启用文件上传
UPLOAD_ENABLED=false

# 上传超时时间（秒，大文件可适当增加）
UPLOAD_TIMEOUT_SECONDS=300

# 分片上传每片大小（KB）
UPLOAD_CHUNK_SIZE_KB=512


# ═══ 文件下载接口（从服务器下载到本地）═══

# 是否启用文件下载
FILE_DOWNLOAD_ENABLED=false


# ═══ 站点源配置 ═══

# aHR0cHM6Ly96eGNzLnppcA==
SOURCE_A_ENABLED=false
SOURCE_A_URL=https://example.com
SOURCE_A_NAME=示例源A

# aHR0cHM6Ly96eGNzLmRtbGIuY2Y=
SOURCE_B_ENABLED=false
SOURCE_B_URL=https://example.com
SOURCE_B_PATH=/
SOURCE_B_NAME=示例源B


# ═══ 文件重命名 ═══

# 重命名模式：
#   0 = 不重命名（默认）
#   1 = 小说名拼音（PascalCase，如 YanYuJiangNan.txt）
#   2 = 中文小说名（如 江南烟雨.txt）
#   3 = 中文小说名-中文作者（如 江南烟雨-张三.txt）
# 文件管理页面顶部提供「一键重命名」按钮，按此模式批量重命名所有未隐藏小说。
# 兼容旧配置：若仅设置 FILE_RENAME_PINYIN=true 而未设置本变量，则按模式1（拼音）处理。
FILE_RENAME_MODE=0

# 旧配置（保留兼容）：true 时等价于 FILE_RENAME_MODE=1
FILE_RENAME_PINYIN=false


# ═══ TTS 朗读 ═══

# 阅读页朗读总开关（false 则前端隐藏朗读按钮）
TTS_ENABLED=true

# Edge-TTS 引擎开关（微软神经网络音质，需服务器能访问微软接口）
TTS_EDGE_ENABLED=true

# 局域网 Piper 引擎开关（自建容器离线合成）
TTS_LOCAL_ENABLED=true

# 局域网 Piper 服务地址（fish-api 容器内经宿主机网关访问宿主映射端口）
# 若 fish-api 与 piper 在同一 docker 网络，可改为 http://piper-tts:5001
TTS_LOCAL_URL=http://172.19.0.1:5051

# Edge-TTS 默认语音（晓晓女声中文）
TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural

# 单次合成最大文本长度（超限 400 拒绝）
TTS_MAX_TEXT_LENGTH=8000

# 合成超时（秒）
TTS_TIMEOUT_SECONDS=120


# ═══ 传输限制 ═══

# 单个文件大小上限（MB）
MAX_FILE_SIZE_MB=50

# 远程拉取下载超时（秒）
DOWNLOAD_TIMEOUT_SECONDS=30
