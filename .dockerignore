# novels/ 由 docker-compose 卷挂载持久化，不进镜像
novels/

# ─── 宿主脚本 ─────────────────────────────────────────
scripts/

# ─── 编辑器 / 系统文件 ────────────────────────────────
.vscode/
.mimocode/
.DS_Store
Thumbs.db
